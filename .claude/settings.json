{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "1h",
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "includeGitInstructions": false,
  "showClearContextOnPlanAccept": true,
  "disableClaudeAiConnectors": true,
  "bashOutputMaxChars": 8000,
  "taskOutputMaxChars": 8000,
  "skillListingBudgetFraction": 0.005,
  "skillListingMaxDescChars": 800,
  "autoMemoryEnabled": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/claude-hooks/run-tests-on-edit.js"],
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./node_modules/**)",
      "Read(**/*.map)",
      "Read(**/*.log)",
      "Read(**/*.idea)"
    ]
  }
}
