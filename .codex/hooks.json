{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').join(require('child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim(),'scripts/claude-hooks/run-tests-on-edit.js')).main()\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
