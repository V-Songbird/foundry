# Local workspaces, backups and maintenance output
.scratch/

# Python cache directories
__pycache__/
.pytest_cache/
node_modules/
.venv/
venv/
.env
.env.*
!.env.example
!.env.sample

.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
# Research and maintained documentation are public project material.
/plugins/

**/.claude/*
!/.claude/settings.json
!/.claude/hooks/
!/.claude/rules/
!/.claude/agents/
!/.claude/skills/

# Nested project stores stay local; Foundry's planning records are shared.
ROADMAP.jsonl
!/ROADMAP.jsonl
.foreman/
!/.foreman/
/.foreman/*
!/.foreman/config.json
!/.foreman/notes.jsonl
!/.foreman/archive.jsonl

# Shared project skills and marketplace; other agent state remains local.
/.agents/*
!/.agents/skills/
!/.agents/plugins/
/.agents/plugins/*
!/.agents/plugins/marketplace.json

# Codex project agents; other Codex configuration and session state remain local.
/.codex/*
!/.codex/agents/
!/.codex/hooks.json

# Plugin-local session state — written at run time, never published
.assay/
.scribe/
