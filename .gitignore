# Foundry repository visibility and local generated files.
# Keep the catalogs, shared agent configuration and public documentation visible.

# Private working material and documentation
.private/
docs/tasks/
docs/decisions/
docs/knowledge/private/
docs/apis/private/

# Local environment values; public .env.example/.sample/.template files stay visible
.env
.env.local
.env.*.local
.dev.vars
.dev.vars.*.local
id_rsa
id_ed25519

# Machine-local agent state; shared instructions, skills and hook configuration stay visible
**/.claude/settings.local.json
**/.claude/memory/
**/.claude/backups/
**/.claude/logs/
**/.claude/worktrees/
**/.claude/transcripts/
**/.claude/skills/synced/
**/.claude/skills/.trash/
**/.claude/plugins/synced/
**/.claude/plugins/.trash/
.claude.json.corrupted.*
CLAUDE.local.md
AGENTS.override.md

# Shared project skills and the Codex catalog; other Codex agent state remains local.
/.agents/*
!/.agents/skills/
!/.agents/plugins/
/.agents/plugins/*
!/.agents/plugins/marketplace.json

# Reproducible dependency and interpreter caches
node_modules/
__pycache__/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.gradle/

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Local planning records stay where their tools expect them; Foundry keeps no roadmap.
ROADMAP.jsonl
ROADMAP.md
.foreman/

# Workstation editor project
.idea/
