#!/usr/bin/env node
"use strict";

// Installed via: git config core.hooksPath scripts/git-hooks
// See check-marketplace-sync.js for the actual check.

const sync = require("./check-marketplace-sync.js").main();
if (sync !== 0) process.exit(sync);
// Each platform catalog owns its branch and immutable release revision.
const platforms = require("./check-platform-marketplaces.js").main(["--staged"]);
if (platforms !== 0) process.exit(platforms);
// Shared copies: a helper duplicated across plugins must not drift in one of
// them. Reads the submodule checkouts, skips whichever is absent.
const copies = require("./check-shared-copies.js").main();
if (copies !== 0) process.exit(copies);
const maintenance = require("./check-maintenance-copies.js").main();
if (maintenance !== 0) process.exit(maintenance);
const graphics = require("./check-graphic-references.js").main();
if (graphics !== 0) process.exit(graphics);
// README nav: every front page keeps a nav line, and every anchor in it still
// resolves. See check-readme-nav.js.
process.exit(require("./check-readme-nav.js").main(["staged"]));
